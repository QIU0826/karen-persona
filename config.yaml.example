# === 人设配置 ===
persona: "xiaoya"           # 选择人设模板（xiaoya / suchi / qiuyao）
her_name: "小雅"             # 她的名字
your_name: "你"              # 她怎么称呼你
location: "上海"             # 地理位置（影响天气、话题）

# === 个性标签（可选）===
tags: []
  # 可选: 话痨 / 嘴硬心软 / 粘人 / 独立 / 浪漫主义 / 闷骚 / 工作狂

# === 选填 ===
# zodiac: ""                 # 星座
# mbti: ""                   # MBTI
# relationship_background: "" # 你们怎么认识的（给她的故事一个起点）

# === 用户→人设映射（选填，QQ 模式专用）===
# 不同 QQ 号对应不同人设。未在此映射中的用户使用上方默认 persona。
# 键建议加引号，避免 YAML 把 QQ 号解析成数字。
# user_personas:
#   "123456789": "qiuyao"

# === QQ 桥接安全（选填；不填则用安全默认值）===
# 反向 WS 监听地址：默认只监听本机回环地址；除非清楚风险，不要改成 "0.0.0.0"。
# one_bot_ws_host: "127.0.0.1"
# 反向 WS 监听端口（默认 18080，需与 NapCat 的 WebSocket 客户端地址一致）。
# one_bot_ws_port: 18080
# 反向 WS 路径（默认 /onebot/v11/ws，需与 NapCat 的地址一致）。
# one_bot_ws_path: "/onebot/v11/ws"
# 握手 token：监听非本机地址 / 跨机连接时必须设置；NapCat 侧填同样的 access_token。
# one_bot_token: "请换成一段足够长的随机字符串"
#
# QQ 白名单：只允许这些 QQ 号和她聊天。留空 = 允许所有人（启动时打印显著警告），
# 个人使用建议至少填自己的 QQ 号。
allowed_users: []

# === 免打扰时段（可选）===
# 她在这个时段内收到消息会推迟到结束时间再回（默认 23:00-07:00）
# start == end 表示关闭免打扰；支持 "23:30" 这样的写法
quiet_hours_start: "23:00"
quiet_hours_end: "07:00"

# === 系统配置 ===
message_frequency_limit: 10  # 每分钟最大自动回复条数（1-120，防封号）
log_level: "info"            # debug / info / warn / error

# === 可观测性（选填）===
# /health 探活 + /cost 成本摘要（零依赖 HTTP，**仅绑定 127.0.0.1**，不对外网开放）。
# 默认 18081；设为 0 关闭。可用 `curl -s http://127.0.0.1:18081/health` 自检。
health_port: 18081
