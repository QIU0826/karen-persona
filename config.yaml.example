# === 人设配置 ===
persona: "xiaoya"           # 选择人设模板（xiaoya / suchi / qiuyao）
her_name: "小雅"             # 她的名字
your_name: "你"              # 她怎么称呼你
location: "上海"             # 地理位置（影响天气、话题）

# === 个性标签（可选）===
tags: []
  # 可选: 话痨 / 嘴硬心软 / 粘人 / 独立 / 浪漫主义 / 闷骚 / 工作狂

# === 选填 ===
# zodiac: ""                 # 星座
# mbti: ""                   # MBTI
# relationship_background: "" # 你们怎么认识的（给她的故事一个起点）

# === 用户→人设映射（选填，QQ 模式专用）===
# 不同 QQ 号对应不同人设。未在此映射中的用户使用上方默认 persona。
# 键建议加引号，避免 YAML 把 QQ 号解析成数字。
# user_personas:
#   "123456789": "qiuyao"

# === QQ 桥接安全（选填；不填则用安全默认值）===
# 反向 WS 监听地址：默认只监听本机回环地址；除非清楚风险，不要改成 "0.0.0.0"。
# one_bot_ws_host: "127.0.0.1"
# 反向 WS 监听端口（默认 18080，需与 NapCat 的 WebSocket 客户端地址一致）。
# one_bot_ws_port: 18080
# 反向 WS 路径（默认 /onebot/v11/ws，需与 NapCat 的地址一致）。
# one_bot_ws_path: "/onebot/v11/ws"
# 握手 token：监听非本机地址 / 跨机连接时必须设置；NapCat 侧填同样的 access_token。
# one_bot_token: "请换成一段足够长的随机字符串"
#
# QQ 白名单：只允许这些 QQ 号和她聊天。留空 = 允许所有人（启动时打印显著警告），
# 个人使用建议至少填自己的 QQ 号。
allowed_users: []

# === 免打扰时段（可选）===
# 她在这个时段内收到消息会推迟到结束时间再回（默认 23:00-07:00）
# start == end 表示关闭免打扰；支持 "23:30" 这样的写法
quiet_hours_start: "23:00"
quiet_hours_end: "07:00"

# === 系统配置 ===
message_frequency_limit: 10  # 每分钟最大自动回复条数（1-120，防封号）
log_level: "info"            # debug / info / warn / error

# === 可观测性（选填）===
# /health 探活 + /cost 成本摘要（零依赖 HTTP，**仅绑定 127.0.0.1**，不对外网开放）。
# 默认 18081；设为 0 关闭。可用 `curl -s http://127.0.0.1:18081/health` 自检。
health_port: 18081

# === 本地 Web 控制台（选填）===
# 只读四视图（聊天 / 记忆 / 关系 / 状态+成本），零依赖、**仅绑定 127.0.0.1**。
# 默认 18082；设为 0 关闭。启动桥接后访问：http://127.0.0.1:18082/
# 跨设备查看请用 SSH 端口转发：ssh -L 18082:127.0.0.1:18082 你的机器
# web_port: 18082
# 可选访问 token：设置后所有请求必须携带 ?token=（浏览器打开时带上）
# 或 X-Web-Token 请求头，否则返回 401。不设置时仅本机可访问，启动会打告警。
# web_token: "请换成一段足够长的随机字符串"
# 是否允许 Web 控制台查看/切换所有用户（默认 false = 只展示主用户；本地自用可开）
# web_all_owners: false

# === 主动发图（调试/测试用，可选；不写则用人设 photoShare 里的值）===
# 亲密度门槛（人设默认 4；测试期可临时调低）
# photo_share_min_closeness: 3
# 发图概率 0-1（人设默认约 0.08 + 情绪/亲密度加成）
# photo_share_probability: 0.6
# 冷却分钟数（人设默认 2 小时）
# photo_share_cooldown_minutes: 1

# === 群聊（可选）===
# 群里被 @ 时，她默认只发文字/QQ 表情/本地贴纸；照片默认不发群（多人语境，隐私保守）。
# 设为 true 后，主动发图触发时会先发配文、再发图片到群里。
# group_photo_enabled: false

# === 语音消息（可选）===
# 她偶尔会用一条短语音代替打字（更像真人：「懒得打字了，直接说」）。
# 本机 TTS 不可用时自动降级为纯文字，不会报错。macOS 用系统自带的 Tingting 中文女声 + SILK 编码。
# voice_enabled: true
# 每轮回复后「顺手发语音」的概率（0-1，默认 0.12；太高会显得刻意）
# voice_probability: 0.12
# 亲密度门槛（0-10，默认 2.5；不熟的时候不会给陌生人发语音）
# voice_min_closeness: 2.5
# 同一用户两条语音的最小间隔（分钟，默认 8）
# voice_cooldown_minutes: 8
# 单条语音最长字数（默认 40；超过会换更短的一句）
# voice_max_chars: 40
# 群聊是否允许发语音（默认 false）
# voice_group_enabled: false

# === 语音的音色与语气（v0.4.1，针对「念起来太像 AI」）===
# 发声人（macOS `say -v '?'` 里挑；默认 Tingting，可试 Meijia / Sinji）
# voice_tts_voice: "Tingting"
# 基准语速（字/分钟，默认 180；真人聊天比朗读慢一点，200 以上会显赶）
# voice_tts_rate: 180
# 语气润色：按情绪/时间调整语速与音高、在分句之间加停顿（默认开）
# voice_style_enabled: true
# 偶尔在句首加一个语气词「嗯…」的概率（默认 0.12；0 = 不加）
# voice_filler_probability: 0.12

# === 打字错字 → 撤回 → 改对（真人感细节，可选）===
# 她偶尔会打错字，隔一会儿撤回，再发一条改对的（默认开启、低概率）。
# 只在私聊的正常回复里发生；危机语境、被中断、延迟补发都不会触发。
# typo_recall_enabled: true
# 每轮回复触发概率（0-1，默认 0.04；调高会显得有点手滑）
# typo_recall_probability: 0.04
# 发错字后多久撤回（毫秒，500-5000，默认 1500）
# typo_recall_delay_ms: 1500
# 同一用户两次撤回的最小间隔（分钟，0-1440，默认 20）
# typo_recall_cooldown_minutes: 20

# === 主动消息链路（v0.4.0）===
# 她会自己找你，靠四条独立链路；可以单独关掉某一条（不写 = 四条全开）：
#   follow_up      她说完一句、你没回，隔 20 分钟~3 小时补一句（不催不追问）
#   open_topic     冷场 3 小时以上，主动开个话头
#   life_share     她自己生活里有事发生（因果链/天气/情绪/时段），想跟你分享
#   silence_revive 好几天没联系，重启联系（一轮失联只问一次）
# 护栏：单日最多 4 条、两次最少间隔 30 分钟、对方不回时一天最多 2 条就收手。
# 调试可以用环境变量 KAREN_PROACTIVE_CHANNELS=off 一次性全关。
# proactive_channels:
#   follow_up: true
#   open_topic: true
#   life_share: true
#   silence_revive: true

# === 合规 ===
# 首次对话时是否明确告知「这是 AI 虚拟角色」以及数据去向。
# 默认 false（个人自用体验优先，不在聊天里插入披露）；公开发布/商用建议显式开启。
# ai_disclosure: false
# 是否要求 QQ 用户先确认已满 18 岁（默认 true；CLI 开发者模式不强制）。
# 这是自我声明式年龄门，不是身份证/生日校验；个人自用可改为 false。
# age_gate_enabled: true
