{
  "name": "karen-persona",
  "version": "0.9.31",
  "description": "QQ AI 虚拟人设聊天系统 - 让通讯录里住进一个有自己生活、情绪和记忆的人",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/test-bot.ts",
    "chat": "tsx src/test-bot.ts",
    "qq": "tsx src/bridge/qq.ts",
    "wechat": "tsx src/index.ts",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "persona:check": "tsx src/persona/check.ts",
    "persona:create": "tsx src/persona/create.ts",
    "persona:narrate": "tsx src/persona/narrate.ts",
    "persona:list": "tsx -e \"import { listPersonas } from './src/persona/loader.js'; console.log(listPersonas().join('\\n'))\"",
    "setup": "tsx src/setup.ts",
    "doctor": "tsx src/doctor.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/eval/bridge-e2e.test.ts",
    "persona:pack:validate": "tsx src/persona/pack-cli.ts validate",
    "persona:pack:install": "tsx src/persona/pack-cli.ts install",
    "persona:pack:list": "tsx src/persona/pack-cli.ts list",
    "qq:watch": "tsx scripts/qq-longrun-watch.ts",
    "models:status": "tsx scripts/models.ts",
    "models:list": "tsx scripts/models.ts --list",
    "models:purge": "tsx scripts/models.ts --purge",
    "embed:start": "cd services/embed && uv run --python 3.12 --with fastapi --with uvicorn --with fastembed server.py",
    "embed:spike": "tsx scripts/spike-embed.ts",
    "asr:start": "tsx scripts/asr-start.ts",
    "asr:smoke": "tsx scripts/asr-smoke.ts",
    "asr:robustness": "tsx scripts/asr-robustness.ts",
    "image:start": "tsx scripts/image-start.ts",
    "image:smoke": "tsx scripts/image-smoke.ts",
    "image:refine": "tsx scripts/image-refine.ts",
    "image:selfie": "tsx scripts/image-selfie.ts",
    "chat:audit": "tsx scripts/chat-realism-audit.ts",
    "hot:show": "tsx scripts/hot-topics.ts",
    "image:audit": "tsx scripts/image-audit.ts",
    "media:status": "tsx scripts/media-setup.ts status",
    "media:install": "tsx scripts/media-setup.ts install",
    "media:pull-model": "tsx scripts/media-setup.ts pull-model",
    "media:start": "tsx scripts/media-setup.ts start",
    "media:purge": "tsx scripts/media-setup.ts purge",
    "eval:offline": "tsx scripts/eval-offline.ts",
    "initiative:sim": "tsx scripts/initiative-sim.ts",
    "proactive:content-eval": "tsx scripts/proactive-content-eval.ts",
    "selfshare:eval": "tsx scripts/selfshare-eval.ts",
    "life:smoke": "tsx scripts/life-smoke.ts",
    "behavior:eval": "tsx scripts/behavior-eval.ts",
    "photo:scene-eval": "tsx scripts/photo-scene-eval.ts",
    "anchor:smoke": "tsx scripts/anchor-smoke.ts",
    "digest:smoke": "tsx scripts/digest-smoke.ts",
    "refine:smoke": "tsx scripts/refine-smoke.ts",
    "rollup:smoke": "tsx scripts/rollup-smoke.ts",
    "proactive:smoke": "tsx scripts/proactive-smoke.ts",
    "eval:memory": "tsx scripts/memory-eval.ts",
    "eval:anchor": "tsx scripts/anchor-eval.ts",
    "eval:live": "tsx scripts/memory-eval.ts --live --limit=40 && tsx scripts/anchor-eval.ts",
    "kokoro:start": "services/kokoro/.venv/bin/python services/kokoro/server.py",
    "kokoro:smoke": "tsx scripts/kokoro-tts-smoke.ts",
    "cosyvoice:start": "services/cosyvoice/.venv/bin/python services/cosyvoice/server.py",
    "cosyvoice:smoke": "tsx scripts/cosyvoice-smoke.ts",
    "indextts:start": "bash services/indextts2/run.sh",
    "indextts:smoke": "tsx scripts/indextts-smoke.ts",
    "voice:ref:add": "tsx scripts/voice-ref-add.ts",
    "photo:reply-eval": "tsx scripts/photo-reply-eval.ts --seeds 2"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.0",
    "openai": "^4.70.0",
    "silk-wasm": "^3.7.1",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
