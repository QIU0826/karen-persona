{
  "name": "karen-persona",
  "version": "0.1.0",
  "description": "QQ AI 虚拟人设聊天系统 - 让通讯录里住进一个有自己生活、情绪和记忆的人",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/test-bot.ts",
    "chat": "tsx src/test-bot.ts",
    "qq": "tsx src/bridge/qq.ts",
    "wechat": "tsx src/index.ts",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "persona:check": "tsx src/persona/check.ts",
    "persona:create": "tsx src/persona/create.ts",
    "persona:narrate": "tsx src/persona/narrate.ts",
    "persona:list": "tsx -e \"import { listPersonas } from './src/persona/loader.js'; console.log(listPersonas().join('\\n'))\"",
    "setup": "tsx src/setup.ts",
    "doctor": "tsx src/doctor.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/eval/bridge-e2e.test.ts",
    "persona:pack:validate": "tsx src/persona/pack-cli.ts validate",
    "persona:pack:install": "tsx src/persona/pack-cli.ts install",
    "persona:pack:list": "tsx src/persona/pack-cli.ts list",
    "qq:watch": "tsx scripts/qq-longrun-watch.ts"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.0",
    "openai": "^4.70.0",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT"
}
