# === 必填 ===
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 模型选择（选填，不填则用默认值）===
# 日常聊天用 flash（simple/normal），深度对话用 pro（complex）
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# 如果你有兼容 OpenAI API 的其他模型：
# DEEPSEEK_BASE_URL=https://your-api.com/v1
# DEEPSEEK_FLASH_MODEL=your-fast-model
# DEEPSEEK_PRO_MODEL=your-powerful-model

# === 选填：高质量文字对话（不填则仅用 DeepSeek）===
# CLAUDE_API_KEY=sk-ant-your-key-here

# === 选填：图片识别 + 语义记忆嵌入（复用同一个 Key）===
# 通义千问 DashScope API Key，同时用于 Qwen-VL 图片识别和 text-embedding-v3 语义嵌入
# QWEN_VL_API_KEY=your-key-here
# 如需为嵌入功能使用独立 Key（可选）:
# QWEN_EMBEDDING_API_KEY=your-key-here

# === 选填：人物照片生成（不填则人物照片功能关闭）===
# JIMENG_API_KEY=your-key-here

# === 选填：天气感知（不填则天气感知关闭）===
# OPENWEATHER_API_KEY=your-key-here

# === 选填：语音合成（不填则语音功能关闭）===
# FISH_AUDIO_API_KEY=your-key-here

# === 选填：Unsplash（不填则风景照片使用本地默认图库）===
# UNSPLASH_ACCESS_KEY=your-key-here

# === QQ 桥接（NapCatQQ OneBot 11 反向 WebSocket）===
# 先启动 NapCatQQ（扫描登录），本服务会自动接收事件。
# NapCat WebUI：网络配置 → 新建「WebSocket 客户端」→ ws://127.0.0.1:18080/onebot/v11/ws
#
# 以下参数也可以写在 config.yaml（one_bot_ws_host / one_bot_ws_port / one_bot_ws_path /
# one_bot_token / allowed_users），两处都写时 config.yaml 优先。
# 安全默认：只监听本机回环地址。除非你清楚风险，不要改成 0.0.0.0。
ONE_BOT_HOST=127.0.0.1
ONE_BOT_WS_PORT=18080
ONE_BOT_WS_PATH=/onebot/v11/ws

# 反向 WS 鉴权 token（选填）。若 NapCat 与本服务不在同一台机器、或监听地址不是 127.0.0.1，
# 必须设置；NapCat 侧在反向 WS URL 后加 ?access_token=... 或配置 Authorization: Bearer。
# ONE_BOT_TOKEN=请换成一段足够长的随机字符串

# QQ 白名单（选填，逗号分隔的 QQ 号）。只允许这些账号和她聊天；
# 留空 = 允许所有 QQ 号（启动时会打印显著安全警告）。
# 个人使用强烈建议填你自己的 QQ 号。
# ALLOWED_USERS=123456789,987654321

# 出站超长消息切分：单条消息字符上限（选填，50-5000，默认 1000）
# ONE_BOT_MAX_MESSAGE_LENGTH=1000
