# === 必填 ===
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === 模型选择（选填，不填则用默认值）===
# 官方模型名（2026-10）：deepseek-flash（V4.1-Flash-1017，日常聊天 + 图片理解）、
# deepseek-v4-pro（V4-Pro-0813，纯文本深度对话）
# 日常聊天用 flash（simple/normal），深度对话用 pro（complex）
# DEEPSEEK_FLASH_MODEL=deepseek-flash
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# 图片识别固定使用 flash 模型，一般无需配置；如需覆盖：
# DEEPSEEK_VISION_MODEL=deepseek-flash
# 如果你有兼容 OpenAI API 的其他模型：
# DEEPSEEK_BASE_URL=https://your-api.com/v1
# DEEPSEEK_FLASH_MODEL=your-fast-model
# DEEPSEEK_PRO_MODEL=your-powerful-model

# === 选填：语音后端 ===
# kokoro（默认，开源中文少女音色，快）| cosyvoice（零样本克隆，慢/占内存）| indextts2（IndexTTS-2.5，MPS，情绪控制）
# 用 cosyvoice 前先启动：npm run cosyvoice:start（约 7GB 内存）
# 用 indextts2 前先按 docs/INDEXTTS2.md 安装并启动：npm run indextts:start（约 8–10GB 内存）
# 参考音用 npm run voice:ref:add 导入到 data/voice-ref/（本地，不入库）
# KAREN_TTS_BACKEND=kokoro
# COSYVOICE_VOICE_ID=xiaoya
# INDEXTTS_TTS_URL=http://127.0.0.1:18088
# INDEXTTS_REF_WAV=/absolute/path/to/data/voice-ref/xiaoya.wav

# === 思考模式（选填，默认关闭）===
# 关闭（默认）：响应更快、更省 token，且不会出现「思考吃光 max_tokens → 空回复」。
# 需要更强推理时可设 enabled；复杂度的思考强度为 simple=low / normal=high / complex=max。
# DEEPSEEK_THINKING=disabled
# 手动指定思考强度（low/high/max），不填则按复杂度自动映射：
# DEEPSEEK_REASONING_EFFORT=high
# LLM 请求超时（毫秒，默认 30000）：
# LLM_TIMEOUT_MS=30000

# === 选填：高质量文字对话（不填则仅用 DeepSeek）===
# CLAUDE_API_KEY=sk-ant-your-key-here

# === 选填：语义记忆嵌入（Qwen Key 仅用于 embedding，可选）===
# 图片识别已改由 DeepSeek Flash 提供，不再需要 Qwen-VL；此 Key 只用于通义千问
# text-embedding-v3 语义嵌入（未配置时自动降级为本地 n-gram 哈希）。
# 配置后：新记忆会写入语义向量（后台升级，不阻塞对话），检索变成「语义向量 + FTS5 关键词」
# 混合检索；未配置时同步路径 = n-gram 向量 + FTS5 关键词（仍可用，只是同义改写召回弱）。
# 隐私提示：启用后记忆文本会发送给阿里云 DashScope。
# QWEN_VL_API_KEY=your-key-here
# 如需为嵌入功能使用独立 Key（可选）:
# QWEN_EMBEDDING_API_KEY=your-key-here
# 强制指定 embedding 方式：auto（默认，有 Key 用 Qwen）/ ngram（只用本地哈希，隐私/离线模式）
# EMBEDDING_PROVIDER=auto
#
# 升级提示（M1-7）：旧库首次启动会自动加列（embedding_model/semantic_embedding/semantic_model）
# 并重建派生索引 t2_vec/t2_fts，不修改 t2_episodes 里的历史内容与 ngram 向量；
# 建议升级前备份：cp data/memory.sqlite data/memory.sqlite.bak
# 配置 Qwen Key 后可在入口手动触发一次历史回填：startBackgroundEmbeddingUpgrade()（幂等，不阻塞启动）。

# === 选填：检索增强（DeepSeek 候选重排，默认开启，无需额外 Key）===
# 每轮对初步召回的 12 条记忆做一次 Flash 相关性重排（1 次小调用，~0.5-0.7s，约 ¥0.00025/轮）。
# 20 条记忆金标实测：T2 recall@1 55%→95%、recall@8 85%→95%（docs/SEMANTIC_BOOST_EVAL.md）。
# 失败/超时/无 Key 自动降级为原检索顺序，不影响回复。
# 关闭：KAREN_SEMANTIC_BOOST=off；超时阈值（默认 2500ms）：KAREN_SEMANTIC_BOOST_TIMEOUT_MS=2500
# KAREN_SEMANTIC_BOOST=rerank
# KAREN_SEMANTIC_BOOST_TIMEOUT_MS=2500

# === 选填：人物照片生成（不填则人物照片功能关闭）===
# JIMENG_API_KEY=your-key-here

# === 选填：天气感知（不填则天气感知关闭）===
# OPENWEATHER_API_KEY=your-key-here

# === 选填：语音合成（不填则语音功能关闭）===
# FISH_AUDIO_API_KEY=your-key-here

# === 选填：Unsplash（不填则风景照片使用本地默认图库）===
# UNSPLASH_ACCESS_KEY=your-key-here

# === 可观测性（选填）===
# /health 探活 + /cost 成本摘要端口（零依赖 HTTP，仅绑定 127.0.0.1；0=关闭）。
# 默认 18081；自检：curl -s http://127.0.0.1:18081/health
# HEALTH_PORT=18081
# 日志：auto（默认，TTY 人类可读 / 非 TTY JSON lines）/ json / text。
# 日志默认脱敏（不打印消息正文 / 凭据 token / Key，只记长度与摘要）。
# LOG_FORMAT=auto
# LOG_LEVEL=info
# 排障开关：设为 1 时日志/控制台会输出内容前 40 字（默认关闭，避免正文落终端/PM2 日志）。
# LOG_CONTENT=1

# === 本地 Web 控制台（选填）===
# 只读四视图（聊天 / 记忆 / 关系 / 状态+成本），零依赖、仅绑定 127.0.0.1。
# 默认 18082，0=关闭；启动桥接后浏览器打开 http://127.0.0.1:18082/
# WEB_PORT=18082
# 可选 token：设置后所有请求必须携带 ?token= 或 X-Web-Token 头，否则 401。
# 不设置时仅本机可访问（启动会打安全告警）。
# WEB_TOKEN=请换成一段足够长的随机字符串
# 注：web_port / web_token / web_all_owners 也可以写在 config.yaml（两处都写时 config.yaml 优先）。
# WEB_ALL_OWNERS=true  # 控制台允许多用户只读切换（默认关）

# === QQ 桥接（NapCatQQ OneBot 11 反向 WebSocket）===
# 先启动 NapCatQQ（扫描登录），本服务会自动接收事件。
# NapCat WebUI：网络配置 → 新建「WebSocket 客户端」→ ws://127.0.0.1:18080/onebot/v11/ws
#
# 以下参数也可以写在 config.yaml（one_bot_ws_host / one_bot_ws_port / one_bot_ws_path /
# one_bot_token / allowed_users），两处都写时 config.yaml 优先。
# 安全默认：只监听本机回环地址。除非你清楚风险，不要改成 0.0.0.0。
ONE_BOT_HOST=127.0.0.1
ONE_BOT_WS_PORT=18080
ONE_BOT_WS_PATH=/onebot/v11/ws

# 反向 WS 鉴权 token（选填）。若 NapCat 与本服务不在同一台机器、或监听地址不是 127.0.0.1，
# 必须设置；NapCat 侧在反向 WS URL 后加 ?access_token=... 或配置 Authorization: Bearer。
# ONE_BOT_TOKEN=请换成一段足够长的随机字符串

# QQ 白名单（选填，逗号分隔的 QQ 号）。只允许这些账号和她聊天；
# 留空 = 允许所有 QQ 号（启动时会打印显著安全警告）。
# 个人使用强烈建议填你自己的 QQ 号。
# ALLOWED_USERS=123456789,987654321

# 出站超长消息切分：单条消息字符上限（选填，50-5000，默认 1000）
# ONE_BOT_MAX_MESSAGE_LENGTH=1000

# 年龄门：是否要求 QQ 用户先回复「我成年了」确认已满 18 岁（默认 true；CLI 不强制）。
# 自我声明式，不是身份证校验；个人自用可 AGE_GATE=false。
# AGE_GATE=true

# 群聊里是否允许她发生活照（默认 false）。群聊是多人语境，默认只发文字/QQ表情/贴纸；
# 设为 true 后主动发图触发时会发到群里（配文 + 图片）。也可以写在 config.yaml: group_photo_enabled
# GROUP_PHOTO=true

# ── 本地向量（v0.5，可选但推荐）──────────────────────
# 开启后检索从「关键词 + 每轮 LLM 重排」升级为真正的语义检索，并省掉每轮 ~664ms 的重排调用。
# 需要先启动本地服务：npm run embed:start（Python + uv，模型缓存在 KAREN_MODELS_DIR）
# KAREN_EMBED=on
# KAREN_EMBED_URL=http://127.0.0.1:18083
# 本地服务不可用时自动降级为字符 n-gram，聊天不会阻塞。
# 强制走 n-gram（离线/隐私/测试）：EMBEDDING_PROVIDER=ngram

# 本地向量已启用时，LLM 重排默认关闭（实测更快且不降质量）；想强制开启：
# KAREN_SEMANTIC_BOOST=on

# ── 记忆 v2（v0.5）────────────────────────────────
# 锚点记忆 + 日记忆注入总开关；设为 off 可整体回退到 v0.4 行为（数据保留，不删）
# KAREN_MEMORY_V2=off

# ── 意图式主动性（v0.8）──────────────────────────
# 每天生成 2–3 个「今天想找他聊什么」的由头，按时间窗/上限/回复率校准发不发。
# 关闭：KAREN_INITIATIVE=off
# KAREN_INITIATIVE=on

# ── 本机生图（v0.8.23 起可用；需先启动 services/image 服务）──
# 启动：npm run image:start
# 默认 off（只用图库）；打开后约 20% 照片由本机生成，点名要照片时直接生成
# KAREN_IMAGE_GEN=on
# KAREN_IMAGE_BACKEND=service
# KAREN_IMAGE_URL=http://127.0.0.1:18084

# ── 语音识别（v0.9.0 起可用；需先启动 services/asr 服务）──
# 启动：npm run asr:start
# 打开后：用户发来的 QQ 语音条会先转文字再进对话（失败自动回退 [语音] 占位）
# KAREN_ASR=on
# KAREN_ASR_URL=http://127.0.0.1:18085

# 自述提及频率控制（v0.9.7 引入；v0.9.8 起**默认关**：
# 两种独立评测都未测出它能降低自述率。想试可显式打开）
# KAREN_MENTION_PACING=on

# GPU2: Qwen-Image-Edit-2511（Mac 侧 SSH 隧道 19110 -> 服务器 18110）
# 只用于 image:refine / image:audit；不改 KAREN_IMAGE_BACKEND
# QWEN_IMAGE_EDIT_URL=http://127.0.0.1:19110

# 生成图强制质检（2026-10-22）：on 时每次生成后都要通过场景/角色/手部/异常检查，
# 不合格或质检服务不可用一律回退图库（fail-closed）。默认 off；本机已开。
# KAREN_IMAGE_GUARD=on

# Z-Image-Turbo（GPU3，Mac 隧道 19111 -> 服务器 18111）
# 只用于场景/照片/中文文字；角色一致性仍走 Qwen-Image-Edit
# ZIMAGE_URL=http://127.0.0.1:19111
# KAREN_IMAGE_BACKEND=z-image

# 流式发图最多等生成+质检多久（Z-Image 约 5s；默认 12000ms）
# KAREN_PHOTO_SHARE_TIMEOUT_MS=12000

# VoxCPM2（GPU2，48kHz；Mac 隧道 19102）
# KAREN_TTS_BACKEND=voxcpm2
# VOXCPM2_TTS_URL=http://127.0.0.1:19102
# VOXCPM2_TIMEOUT_MS=60000

# SenseVoice（GPU3，ASR + 情绪/音频事件；Mac 隧道 19112）
# KAREN_ASR_BACKEND=sensevoice
# SENSEVOICE_URL=http://127.0.0.1:19112
# SENSEVOICE_TIMEOUT_MS=5000

# Qwen2.5-Omni-7B 音频理解（GPU3，Mac 隧道 19113）
# KAREN_ASR_BACKEND=qwen-omni
# QWEN_OMNI_URL=http://127.0.0.1:19113
